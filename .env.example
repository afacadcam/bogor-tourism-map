# Django Core Settings
SECRET_KEY=change-this-to-a-very-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Sub-Path Configuration (Kosongkan jika di root domain, atau isi misal '/python')
SUB_PATH=

# Database Configuration (PostgreSQL + PostGIS wajib aktif)
DB_NAME=bogor_tourism_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Static & Media Storage (Opsional, gunakan default jika tidak diubah)
# STATIC_ROOT=/var/www/html/bogor_tourism_map/staticfiles
# MEDIA_ROOT=/var/www/html/bogor_tourism_map/media
